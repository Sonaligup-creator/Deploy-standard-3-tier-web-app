{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "frontend", "api", "postgres"],
  "definitions": {
    "cpuMemory": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/cpuMemory" },
        "limits": { "$ref": "#/definitions/cpuMemory" }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "required": ["ingress", "paths", "database", "workloadIdentity"],
      "properties": {
        "ingress": {
          "type": "object",
          "required": ["enabled", "className", "host"],
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "host": { "type": "string", "minLength": 1 },
            "annotations": { "type": "object" }
          }
        },
        "paths": {
          "type": "object",
          "required": ["frontend", "api"],
          "properties": {
            "frontend": { "type": "string" },
            "api": { "type": "string" }
          }
        },
        "database": {
          "type": "object",
          "required": ["secretName", "port"],
          "properties": {
            "secretName": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "externalHost": { "type": "string" }
          }
        },
        "workloadIdentity": {
          "type": "object",
          "required": ["enabled", "clientId", "tenantId", "keyVaultName", "secretProviderClassName"],
          "properties": {
            "enabled": { "type": "boolean" },
            "clientId": { "type": "string", "minLength": 1 },
            "tenantId": { "type": "string", "minLength": 1 },
            "keyVaultName": { "type": "string", "minLength": 1 },
            "secretProviderClassName": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "port": { "type": "integer" },
            "targetPort": { "type": "integer" }
          }
        },
        "database": {
          "type": "object",
          "properties": {
            "host": { "type": "string" }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "api": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "port": { "type": "integer" },
            "targetPort": { "type": "integer" }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "postgres": {
      "type": "object",
      "required": ["enabled", "image", "persistence"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "port": { "type": "integer" }
          }
        },
        "persistence": {
          "type": "object",
          "required": ["enabled", "size", "storageClassName"],
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string", "minLength": 1 },
            "storageClassName": { "type": "string", "minLength": 1 }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "frontend": { "properties": { "enabled": { "const": true } } } } },
      "then": { "properties": { "frontend": { "required": ["resources"] } } }
    },
    {
      "if": { "properties": { "api": { "properties": { "enabled": { "const": true } } } } },
      "then": { "properties": { "api": { "required": ["resources"] } } }
    },
    {
      "if": { "properties": { "postgres": { "properties": { "enabled": { "const": true } } } } },
      "then": { "properties": { "postgres": { "required": ["resources"] } } }
    }
  ]
}
